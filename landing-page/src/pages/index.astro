                </button>
              </div>

              <div class="transport">
                <button type="button" id="walkthrough-prev" aria-label="Previous step">←</button>
                <button type="button" id="walkthrough-next" aria-label="Next step">→</button>
                <button type="button" id="walkthrough-play" data-play aria-label="Play walkthrough">
