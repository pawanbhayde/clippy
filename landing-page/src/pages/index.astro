---
import Layout from '@/layouts/Layout.astro';
---

<Layout>
  <!-- ══════════════════════════════════════════════════════════════
       HERO — FULL RED/SCARLET ACCENT VIEWPORT
       ══════════════════════════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <header class="site-header" role="banner">
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/" class="site-logo" aria-label="Clippy Home">
          <img src="/icon.png" alt="Clippy" width="28" height="28" class="rounded-md border border-black/20" />
          <span>CLIPPY</span>
        </a>

        <div class="hidden md:flex items-center gap-8 font-mono text-xs uppercase font-bold tracking-wider text-black/80">
          <a href="#the-problem" class="hover:text-black transition-colors">The Problem</a>
          <a href="#intro-clippy" class="hover:text-black transition-colors">The Notch</a>
          <a href="#difference" class="hover:text-black transition-colors">Architecture</a>
          <a href="#how-it-works" class="hover:text-black transition-colors">How It Works</a>
          <a href="#faq" class="hover:text-black transition-colors">FAQ</a>
        </div>

        <a
          href="https://github.com/pawanbhayde/clippy"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-chamfer btn-dark site-nav-cta"
          id="nav-join-btn"
        >
          View on GitHub ↗
        </a>
      </nav>
    </header>

    <!-- Hero watermark (Stylized Precision Dynamic Island & Notch Wireframe) -->
    <svg
      class="hero-watermark"
      viewBox="0 0 400 240"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <rect x="20" y="20" width="360" height="200" rx="36" stroke="currentColor" stroke-width="3" stroke-dasharray="6 6" />
      <path d="M120 20 H280 V60 C280 76 268 88 252 88 H148 C132 88 120 76 120 60 Z" fill="currentColor" opacity="0.3" />
      <circle cx="200" cy="54" r="10" fill="currentColor" />
      <rect x="70" y="120" width="260" height="64" rx="16" stroke="currentColor" stroke-width="2" />
      <path d="M100 152 H160 M180 152 H240 M260 152 H300" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    </svg>

    <div class="hero-content">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-black/10 border border-black/20 font-mono text-xs uppercase font-bold tracking-widest text-black/80 mb-2">
        <span class="w-2 h-2 rounded-full bg-black animate-pulse"></span>
        <span>macOS Sonoma 14+ & Sequoia 15+ • 100% Native Swift</span>
      </div>

      <h1 class="display">
        Turn Your Notch<br />
        Into A Superpower
      </h1>

      <p class="hero-sub">
        The open-source, 100% native macOS clipboard manager living directly inside your MacBook camera bezel. Sequential paste queues, Apple Vision OCR, and multi-clip merging—all on-device and privacy-first.
      </p>

      <div class="hero-actions">
        <a
          href="https://github.com/pawanbhayde/clippy"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-chamfer btn-dark"
          id="hero-github-btn"
        >
          <svg class="w-4 h-4 fill-current inline-block mr-1" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
          </svg>
          <span>View on GitHub</span>
          <span class="opacity-70 font-normal">★ 1.4k</span>
        </a>

        <button
          type="button"
          class="btn-chamfer btn-dark"
          id="hero-clone-btn"
          onclick="navigator.clipboard.writeText('git clone https://github.com/pawanbhayde/clippy.git && cd clippy && open clippy.xcodeproj'); const el = document.getElementById('hero-clone-text'); el.innerText = 'Copied Clone Command!'; setTimeout(() => el.innerText = 'git clone ... clippy.xcodeproj', 2200);"
        >
          <span class="opacity-60 font-mono">$</span>
          <span id="hero-clone-text">git clone ... clippy.xcodeproj</span>
        </button>

        <a
          href="#specs"
          class="btn-chamfer btn-dark"
        >
          <span>Build Instructions</span>
          <span class="opacity-60">↓</span>
        </a>
      </div>
    </div>

    <!-- News & Feature Ticker Tape Marquee -->
    <div class="hero-ticker" aria-label="Clippy announcements">
      <div class="hero-ticker-inner">
        <div class="hero-ticker-group">
          <span>Clippy v1.0 Released for macOS Sonoma & Sequoia</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>100% Native Swift, AppKit & SwiftUI</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Zero Telemetry • Zero Network Entitlements Verified</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Sequential FIFO Paste Queue (⌘⌥V)</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Hardware-Accelerated Apple Vision OCR</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Instant Multi-Item Merger with SQL, CSV & Markdown</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Keychain AES-256-GCM Hardware Encryption</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Side-by-Side Visual Myers Diff Engine</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
        </div>
        <div class="hero-ticker-group" aria-hidden="true">
          <span>Clippy v1.0 Released for macOS Sonoma & Sequoia</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>100% Native Swift, AppKit & SwiftUI</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Zero Telemetry • Zero Network Entitlements Verified</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Sequential FIFO Paste Queue (⌘⌥V)</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Hardware-Accelerated Apple Vision OCR</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Instant Multi-Item Merger with SQL, CSV & Markdown</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Keychain AES-256-GCM Hardware Encryption</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
          <span>Side-by-Side Visual Myers Diff Engine</span>
          <span class="hero-ticker-separator" aria-hidden="true">&bull;</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Script for Ticker Duration Calculation -->
  <script is:inline>
    document.querySelectorAll(".hero-ticker-inner").forEach((r) => {
      const e = r.querySelector(".hero-ticker-group");
      if (!e) return;
      const o = () => {
        r.style.setProperty("--ticker-duration", `${e.getBoundingClientRect().width / 38}s`);
      };
      o();
      new ResizeObserver(o).observe(e);
    });
  </script>

  <!-- ══════════════════════════════════════════════════════════════
       SECTION 1: THE PROBLEM (Numbered 3-Column Technical Grid)
       ══════════════════════════════════════════════════════════════ -->
  <main class="content">
    <div style="padding-bottom: 4rem;">
      <div class="section-divider" style="position: relative; top: 4rem;"></div>
    </div>

    <section class="signal-section problem-section" id="the-problem">
      <div class="container problem-container">
        <div class="problem-outer">
          <!-- TOP: Badge + Headline -->
          <div class="problem-top">
            <div class="badge problem-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M 11 11 L 13 11 L 13 13 L 11 13 Z M 15 7 L 17 7 L 17 9 L 15 9 Z M 7 7 L 9 7 L 9 9 L 7 9 Z M 7 15 L 9 15 L 9 17 L 7 17 Z M 15 15 L 17 15 L 17 17 L 15 17 Z M 5 17 L 7 17 L 7 19 L 5 19 Z M 5 5 L 7 5 L 7 7 L 5 7 Z M 9 13 L 11 13 L 11 15 L 9 15 Z M 13 13 L 15 13 L 15 15 L 13 15 Z M 13 9 L 15 9 L 15 11 L 13 11 Z M 9 9 L 11 9 L 11 11 L 9 11 Z M 17 5 L 19 5 L 19 7 L 17 7 Z M 17 17 L 19 17 L 19 19 L 17 19 Z" fill="var(--primary)"></path>
              </svg>
              The Bottleneck
            </div>
            <h2 class="display problem-headline">The Standard Clipboard is Stuck in 1984</h2>
          </div>

          <div class="problem-divider"></div>

          <!-- BOTTOM: 3-column grid (SVG flow illustration + 2x2 cards) -->
          <div class="problem-grid">
            <!-- Left: Looping review checkpoint -->
            <div class="problem-checkpoint-col">
              <svg viewBox="0 0 380 440" fill="none" class="w-full h-auto max-w-[340px]" role="img">
                <rect x="20" y="20" width="340" height="400" rx="8" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4" />
                
                <!-- Notch Anchor Schematic -->
                <path d="M120 20 H260 V56 C260 68 250 78 238 78 H142 C130 78 120 68 120 56 Z" fill="rgba(237, 70, 45, 0.15)" stroke="var(--primary)" stroke-width="1.5" />
                <circle cx="190" cy="48" r="6" fill="var(--primary)" />
                <text x="190" y="70" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--primary)" letter-spacing="1">CAMERA NOTCH</text>

                <!-- Flow arrows -->
                <path d="M190 85 V125" stroke="var(--border)" stroke-width="1.5" stroke-dasharray="3 3" />
                <path d="M186 120 L190 126 L194 120" stroke="var(--primary)" stroke-width="1.5" />

                <!-- Card 1: Copy Stream -->
                <g transform="translate(60, 130)">
                  <rect width="260" height="52" rx="4" fill="#12141c" stroke="var(--border)" />
                  <rect x="12" y="14" width="24" height="24" rx="4" fill="rgba(240, 237, 230, 0.08)" />
                  <text x="24" y="30" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--paper)">⌘C</text>
                  <text x="48" y="26" font-family="var(--font-mono)" font-size="11" font-weight="bold" fill="var(--paper)">auth_token_prod_98a</text>
                  <text x="48" y="40" font-family="var(--font-mono)" font-size="9" fill="var(--paper-dim)">Overwrites previous clipboard buffer</text>
                </g>

                <path d="M190 185 V225" stroke="var(--primary)" stroke-width="1.5" />
                <path d="M186 220 L190 226 L194 220" stroke="var(--primary)" stroke-width="1.5" />

                <!-- Card 2: Rework / Loss -->
                <g transform="translate(60, 230)">
                  <rect width="260" height="52" rx="4" fill="rgba(237, 70, 45, 0.08)" stroke="rgba(237, 70, 45, 0.3)" />
                  <rect x="12" y="14" width="24" height="24" rx="4" fill="rgba(237, 70, 45, 0.2)" />
                  <text x="24" y="30" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--primary)">!</text>
                  <text x="48" y="26" font-family="var(--font-mono)" font-size="11" font-weight="bold" fill="var(--primary)">Context Destruction</text>
                  <text x="48" y="40" font-family="var(--font-mono)" font-size="9" fill="var(--paper-dim)">Forced to tab back 4 times to find old snippet</text>
                </g>

                <path d="M190 285 V325" stroke="var(--border)" stroke-width="1.5" stroke-dasharray="3 3" />
                <path d="M186 320 L190 326 L194 320" stroke="var(--border)" stroke-width="1.5" />

                <!-- Result Status -->
                <g transform="translate(60, 330)">
                  <rect width="260" height="56" rx="4" fill="#08090c" stroke="var(--border)" />
                  <circle cx="28" cy="28" r="8" fill="rgba(253, 224, 71, 0.2)" />
                  <text x="28" y="32" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="#fde047">⚠</text>
                  <text x="48" y="26" font-family="var(--font-mono)" font-size="11" font-weight="bold" fill="var(--paper)">24 mins lost per day</text>
                  <text x="48" y="42" font-family="var(--font-mono)" font-size="9" fill="var(--paper-35)">Continuous cognitive context switching</text>
                </g>
              </svg>
            </div>

            <!-- Top-middle: Destructive Overwrite -->
            <div class="problem-card">
              <div class="problem-card-header">
                <span class="mono problem-card-label">Destruction</span>
                <span class="mono problem-card-number">001</span>
              </div>
              <h3 class="display-heavy">Accidental Overwrites</h3>
              <p>One inadvertent ⌘C completely obliterates your copied database credentials, API response, or design specs from 5 seconds ago.</p>
            </div>

            <!-- Top-right: Tab Shuffle -->
            <div class="problem-card">
              <div class="problem-card-header">
                <span class="mono problem-card-label">Latency</span>
                <span class="mono problem-card-number">002</span>
              </div>
              <h3 class="display-heavy">Exhausting Tab Shuffling</h3>
              <p>Filling out multiple forms or copying 4 values from Linear into code forces 8 round-trip window switches and constant mental interruption.</p>
            </div>

            <!-- Bottom-middle: Cloud Privacy Risks -->
            <div class="problem-card">
              <div class="problem-card-header">
                <span class="mono problem-card-label">Privacy</span>
                <span class="mono problem-card-number">003</span>
              </div>
              <h3 class="display-heavy">Cloud Telemetry Exposure</h3>
              <p>Commercial clipboard managers upload your clipboard history—including passwords and private keys—to third-party remote analytics servers.</p>
            </div>

            <!-- Bottom-right: Screenshot Bloat -->
            <div class="problem-card">
              <div class="problem-card-header">
                <span class="mono problem-card-label">Friction</span>
                <span class="mono problem-card-number">004</span>
              </div>
              <h3 class="display-heavy">Screenshot Graveyards</h3>
              <p>Your Desktop gets cluttered with dozens of throwaway screenshots just to transcribe text from an image or video frame.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <!-- ══════════════════════════════════════════════════════════════
         SECTION 2: INTRODUCING CLIPPY (Interactive Walkthrough / Loop)
         ══════════════════════════════════════════════════════════════ -->
    <section class="offline-section" id="intro-clippy">
      <div class="container">
        <div class="intro-headline-wrap">
          <div class="badge">Introducing Clippy</div>
          <h2 class="display intro-title">
            Spatial Clipboard<br />
            Inside Your Notch
          </h2>
          <p class="intro-desc">
            Clippy lives directly in the hardware bezel of your MacBook display. Hover to drop down the shelf, queue sequential clips with ⌘⌥V, and extract text with Apple Vision OCR.
          </p>
        </div>

        <div class="walkthrough" id="clippy-walkthrough" data-step="0" data-playing="false">
          <!-- Left: Simulated Product Demo Terminal / Editor -->
          <figure class="product-demo" aria-label="Interactive Clippy feature simulator">
            <figcaption>
              <span class="demo-dot"></span>
              <span>macOS • Clippy Dynamic Island Shelf</span>
            </figcaption>

            <div class="editor-bar">
              <span class="file-tab">⌘ &nbsp; shelf.notch.swift</span>
              <span class="file-status">100% On-Device</span>
            </div>

            <!-- Interactive Code / Mockup Editor Bar -->
            <div class="code-editor">
              <div class="code-line">
                <span>01</span>
                <code><b>import</b> SwiftUI</code>
              </div>
              <div class="code-line">
                <span>02</span>
                <code><b>import</b> Vision</code>
              </div>
              <div class="code-line">
                <span>03</span>
                <code><b class="text-[#f87171]">@NotchShelf</b> <b>struct</b> ClipboardQueue &#123;</code>
              </div>
              <div class="code-line" id="dynamic-code-line">
                <span>04</span>
                <code id="step-code-preview">  <b>let</b> activeMode = <em>"Sequential FIFO Queue (⌘⌥V)"</em>;</code>
              </div>
              <div class="code-line">
                <span>05</span>
                <code>&#125;</code>
              </div>

              <div class="code-note">
                <span class="note-before" id="note-state">+ Notch Anchor: Active</span>
                <span class="note-after" id="note-mode">Mode: Queue (3 items buffered)</span>
              </div>
            </div>

            <!-- Interactive Visual Preview Scenes -->
            <div class="demo-conversation">
              <div class="chat-header">
                <span class="agent-avatar">⌘</span>
                <span>Active Island Preview</span>
                <span class="text-xs font-mono text-zinc-500 ml-auto" id="active-scene-badge">SCENE 01 / NOTCH</span>
              </div>

              <div class="chat-thread" id="walkthrough-thread">
                <!-- Scene 0: Notch Shelf Preview -->
                <div class="demo-scene" data-scene="0">
                  <div class="user-message">
                    <span>Action</span>
                    <p class="font-mono text-xs">Hover cursor over top camera notch</p>
                  </div>
                  <div class="assistant-message">
                    <span class="message-author">Clippy Shelf</span>
                    <p>Dynamic Island drops down instantly with live spring physics. Shows recent clipboard items, search bar with tokens (<code class="bg-black/40 px-1 py-0.5 rounded">app:xcode</code>), and quick-look preview.</p>
                  </div>
                  <div class="tool-message">
                    <div class="tool-heading">
                      <span class="text-amber-400">●</span>
                      <span>Hardware Notch Anchor</span>
                      <span class="tool-state running">ProMotion 120Hz</span>
                    </div>
                    <div class="tool-body font-mono text-xs">
                      Window ID: 0x24a | Bounds: (x: 648, y: 0, w: 216, h: 44) | Latency: 0.2ms
                    </div>
                  </div>
                </div>

                <!-- Scene 1: Sequential FIFO Queue -->
                <div class="demo-scene" data-scene="1" hidden>
                  <div class="user-message">
                    <span>Shortcut</span>
                    <p class="font-mono text-xs">Press ⌘⌥V to paste sequentially</p>
                  </div>
                  <div class="assistant-message">
                    <span class="message-author">Queue Processor</span>
                    <p>Popped item 1 of 4: <code class="text-emerald-400 font-mono">auth_token_eyJhbGciOi...</code> into active editor. Remaining: 3 items in queue.</p>
                  </div>
                  <div class="tool-message">
                    <div class="tool-heading">
                      <span class="text-emerald-400">✓</span>
                      <span>Sequential FIFO Buffer</span>
                      <span class="tool-state passed">Auto-Advancing</span>
                    </div>
                    <div class="tool-body font-mono text-xs">
                      Queue: [Client Name] → [Email] → [API Key] → [DB Host]
                    </div>
                  </div>
                </div>

                <!-- Scene 2: Apple Vision OCR -->
                <div class="demo-scene" data-scene="2" hidden>
                  <div class="user-message">
                    <span>Trigger</span>
                    <p class="font-mono text-xs">Screenshot or image copied to clipboard</p>
                  </div>
                  <div class="assistant-message">
                    <span class="message-author">VNRecognizeTextRequest</span>
                    <p>Extracted 14 lines of formatted Swift code from screenshot in 18ms. Text copied directly to clipboard buffer with zero cloud upload.</p>
                  </div>
                  <div class="tool-message">
                    <div class="tool-heading">
                      <span class="text-sky-400">●</span>
                      <span>Apple Vision Framework</span>
                      <span class="tool-state passed">100% Offline</span>
                    </div>
                    <div class="tool-body font-mono text-xs">
                      Neural Engine accelerated | Confidence: 99.4% | Network: Disconnected
                    </div>
                  </div>
                </div>

                <!-- Scene 3: Multi-Item Merger & Diff -->
                <div class="demo-scene" data-scene="3" hidden>
                  <div class="user-message">
                    <span>Selection</span>
                    <p class="font-mono text-xs">⌘-Click 3 clips → Merge as SQL Clause</p>
                  </div>
                  <div class="assistant-message">
                    <span class="message-author">Merger Engine</span>
                    <p>Synthesized 3 clips into SQL: <code class="text-yellow-400 font-mono">IN ('user_102', 'user_409', 'user_881')</code>. Ready to paste.</p>
                  </div>
                  <div class="tool-message">
                    <div class="tool-heading">
                      <span class="text-emerald-400">✓</span>
                      <span>Visual Myers Diff</span>
                      <span class="tool-state passed">Zero Conflicts</span>
                    </div>
                    <div class="tool-body font-mono text-xs">
                      Line diff: 4 additions (+), 1 deletion (-) | Patch copied
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="demo-footer">
              <span class="local-dot"></span>
              <span>LOCAL WORKSPACE</span>
              <span class="ml-auto text-zinc-500 font-mono">NATIVE SWIFT 6.0</span>
            </div>
          </figure>

          <!-- Right: Step Descriptions and Controls -->
          <div class="walkthrough-copy">
            <div class="step-copy-stack" id="clippy-step-description">
              <!-- Step 0 -->
              <div class="step-copy" data-copy="0">
                <div class="step-heading">
                  <span class="step-kicker">THE NOTCH / 01</span>
                  <h3>Spatial Shelf at Your Cursor</h3>
                </div>
                <p>
                  Clippy hugs the MacBook display camera housing. Hovering over the notch gently drops down the shelf. Drag files into the notch to hold them while switching across macOS Spaces.
                </p>
              </div>

              <!-- Step 1 -->
              <div class="step-copy" data-copy="1" hidden>
                <div class="step-heading">
                  <span class="step-kicker">THE QUEUE / 02</span>
                  <h3>Sequential FIFO Pasting (⌘⌥V)</h3>
                </div>
                <p>
                  Copy 5 items in sequence from Slack or Linear. Switch to your IDE and press ⌘⌥V repeatedly to pop each item into place in exact order, with zero window swapping.
                </p>
              </div>

              <!-- Step 2 -->
              <div class="step-copy" data-copy="2" hidden>
                <div class="step-heading">
                  <span class="step-kicker">VISION OCR / 03</span>
                  <h3>Instant Hardware OCR</h3>
                </div>
                <p>
                  Copy any screenshot or drag an image into the notch. Clippy uses Apple's native Vision framework to instantly extract text offline with Apple Neural Engine acceleration.
                </p>
              </div>

              <!-- Step 3 -->
              <div class="step-copy" data-copy="3" hidden>
                <div class="step-heading">
                  <span class="step-kicker">SYNTHESIS / 04</span>
                  <h3>Multi-Clip Merger & Visual Diff</h3>
                </div>
                <p>
                  Combine multiple clipboard fragments into formatted SQL clauses, CSV strings, or markdown lists with 1 click. Compare two code snippets side-by-side using the built-in Myers diff engine.
                </p>
              </div>
            </div>

            <!-- Interactive Stepper Controls -->
            <div class="walkthrough-controls">
              <div class="step-markers">
                <button type="button" data-go="0" aria-current="step" aria-label="Step 1: Notch">
                  <span>01</span>
