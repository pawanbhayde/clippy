    <!-- Script for Interactive Walkthrough Controller -->
    <script is:inline>
      (function () {
        const root = document.getElementById("clippy-walkthrough");
        if (!root) return;

        let currentStep = 0;
        let isPlaying = false;
        let timer = null;

        const scenes = root.querySelectorAll("[data-scene]");
        const copies = root.querySelectorAll("[data-copy]");
        const buttons = root.querySelectorAll("[data-go]");
        const playBtn = document.getElementById("walkthrough-play");
        const prevBtn = document.getElementById("walkthrough-prev");
        const nextBtn = document.getElementById("walkthrough-next");
        const badge = document.getElementById("active-scene-badge");
        const codeLine = document.getElementById("step-code-preview");
        const noteState = document.getElementById("note-state");
        const noteMode = document.getElementById("note-mode");

        const codeSnippets = [
          '  <b>let</b> activeMode = <em>"Notch Spatial Shelf (ProMotion 120Hz)"</em>;',
          '  <b>let</b> activeMode = <em>"Sequential FIFO Queue (⌘⌥V Active)"</em>;',
          '  <b>let</b> activeMode = <em>"Apple Vision OCR (Neural Engine Offline)"</em>;',
          '  <b>let</b> activeMode = <em>"Multi-Item Synthesis (SQL & Myers Diff)"</em>;',
        ];

        const titles = [
          "SCENE 01 / NOTCH SHELF",
          "SCENE 02 / FIFO QUEUE",
          "SCENE 03 / VISION OCR",
          "SCENE 04 / SYNTHESIS & DIFF",
        ];

        function setStep(step) {
          currentStep = (step + 4) % 4;
          root.dataset.step = currentStep;

          scenes.forEach((s, idx) => {
            s.hidden = idx !== currentStep;
          });

          copies.forEach((c, idx) => {
            c.hidden = idx !== currentStep;
          });

          buttons.forEach((b, idx) => {
            if (idx === currentStep) {
              b.setAttribute("aria-current", "step");
            } else {
              b.removeAttribute("aria-current");
            }
          });

          if (badge) badge.innerText = titles[currentStep];
          if (codeLine) codeLine.innerHTML = codeSnippets[currentStep];
          if (noteState) noteState.innerText = `+ Step 0${currentStep + 1}: Loaded`;
          if (noteMode) noteMode.innerText = `Status: Active (${currentStep === 1 ? "FIFO ⌘⌥V" : "Ready"})`;
        }

        buttons.forEach((b) => {
          b.addEventListener("click", () => {
            stopPlay();
            setStep(Number(b.dataset.go));
          });
        });

        prevBtn?.addEventListener("click", () => {
          stopPlay();
          setStep(currentStep - 1);
        });

        nextBtn?.addEventListener("click", () => {
          stopPlay();
          setStep(currentStep + 1);
        });

        function startPlay() {
          isPlaying = true;
          if (playBtn) playBtn.innerHTML = 'Pause <span aria-hidden="true">Ⅱ</span>';
          timer = setInterval(() => {
            setStep(currentStep + 1);
          }, 3500);
        }

        function stopPlay() {
          isPlaying = false;
          if (timer) clearInterval(timer);
          if (playBtn) playBtn.innerHTML = 'Play <span aria-hidden="true">▶</span>';
        }

        playBtn?.addEventListener("click", () => {
          if (isPlaying) {
            stopPlay();
          } else {
            startPlay();
          }
        });
      })();
    </script>

